{
  "name": "glean-code-repl",
  "displayName": "Glean Code (REPL)",
  "description": "VS Code panel that spawns the glean-code Python REPL and pipes output into a webview chat.",
  "version": "0.1.0",
  "publisher": "barkz",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gleanCodeContainer",
          "title": "Glean Code",
          "icon": "resources/glean.svg"
        }
      ]
    },
    "views": {
      "gleanCodeContainer": [
        {
          "type": "webview",
          "id": "gleanCode.chatView",
          "name": "Chat",
          "icon": "resources/glean.svg",
          "contextualTitle": "Glean Code"
        }
      ]
    },
    "commands": [
      {
        "command": "gleanCode.focusChat",
        "title": "Glean Code: Focus Chat",
        "category": "Glean Code"
      },
      {
        "command": "gleanCode.restartRepl",
        "title": "Glean Code: Restart REPL",
        "category": "Glean Code"
      },
      {
        "command": "gleanCode.runSlashCommand",
        "title": "Glean Code: Run Slash Command...",
        "category": "Glean Code"
      },
      {
        "command": "gleanCode.search",
        "title": "Glean Code: Search...",
        "category": "Glean Code"
      },
      {
        "command": "gleanCode.chat",
        "title": "Glean Code: Chat...",
        "category": "Glean Code"
      }
    ],
    "keybindings": [
      {
        "command": "gleanCode.focusChat",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "gleanCode.runSlashCommand",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/"
      }
    ],
    "configuration": {
      "title": "Glean Code",
      "properties": {
        "gleanCode.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python 3 interpreter used to run the glean_code REPL."
        },
        "gleanCode.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the glean-code-cli project root (the directory that contains the glean_code package). Leave blank to use the bundled fallback."
        },
        "gleanCode.extraEnv": {
          "type": "object",
          "default": {},
          "description": "Extra environment variables forwarded to the spawned REPL.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "mkdir -p dist && vsce package --no-dependencies --out dist/",
    "clean": "rm -rf out dist"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^3.2.0"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/barkz/glean-code-vscode-extension.git",
    "directory": "version-1-repl"
  },
  "bugs": {
    "url": "https://github.com/barkz/glean-code-vscode-extension/issues"
  },
  "homepage": "https://github.com/barkz/glean-code-vscode-extension/tree/main/version-1-repl#readme",
  "keywords": [
    "glean",
    "enterprise search",
    "repl"
  ],
  "galleryBanner": {
    "color": "#1a1a1a",
    "theme": "dark"
  }
}
